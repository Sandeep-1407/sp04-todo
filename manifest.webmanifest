{
  "name": "SP04 Daily Organizer",
  "short_name": "SP04",
  "description": "Expenses, to-do with calendar, notes, diary, sheets, passwords and photo locker — all in one, locked with your PIN.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
